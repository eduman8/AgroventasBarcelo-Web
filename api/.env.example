# Entorno
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=false

# Seguridad y límites HTTP
JSON_BODY_LIMIT_KB=100
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Autenticación
JWT_SECRET=change_me_use_at_least_32_characters_in_production
JWT_EXPIRES_IN_SECONDS=86400

# SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_INSTANCE=
DB_DATABASE=AgroBarcelo
DB_USER=sa
DB_PASSWORD=change_me
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Setup de tablas desde endpoints administrativos
ALLOW_DB_SETUP=false

# Email de contacto
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO_EMAIL=consultas@agrobarcelo.com
CONTACT_FROM_EMAIL=no-reply@agrobarcelo.com

# Archivos administrables
MACHINE_IMAGE_MAX_BYTES=5242880
MANUALES_VISUALES_MAX_PDF_BYTES=31457280
MANUALES_VISUALES_PDF_DPI=144
